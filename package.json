{
  "name": "SLSDeckUniversal",
  "version": "0.9.61",
  "description": "SLSDeck for Decky Loader — add games to Steam on SteamOS via SLSsteam (SteamTools replacement), with guided h3adcr-b install, multiple API keys, an injected add button + floating status window, and game fixes.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "decky",
    "h3adcr-b",
    "slsdeck",
    "plugin",
    "slssteam",
    "steam-deck",
    "steamos"
  ],
  "author": "unknown",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
